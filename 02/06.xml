<channel>
<name>Baki - O Campeão</name>
<year>2018</year>
<genre>Animação, Ação, Aventura, Crime, Drama</genre>
<thumbnail>https://image.tmdb.org/t/p/original/hTlJIKptJedaho7N42xCdX0dJyY.jpg</thumbnail>
